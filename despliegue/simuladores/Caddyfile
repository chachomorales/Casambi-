# Los simuladores web (repositorio casambi-wifi-coverage, carpeta web/www):
# archivos estáticos en /srv, que sube web/tools/publicar.sh de ese repositorio.
#
# Como CASAMBI, solo se llega por el túnel de Cloudflare, detrás de Access. No
# validamos el JWT aquí (Caddy no lo hace sin un plugin), pero sí exigimos su
# cabecera: una petición que no pasó por Access no la trae, y se queda en 403.
# Es la misma prueba que el «curl → 403» del README.

:80 {
	@sinAccess not header Cf-Access-Jwt-Assertion *
	respond @sinAccess "Acceso solo por Cloudflare Access" 403

	root * /srv
	encode zstd gzip

	# Nada se guarda en caché fuera de la app: ni el navegador sin preguntar
	# ni Cloudflare, que por su cuenta guardaba los .js y .css 4 horas en su
	# borde. Así salió una publicación con la página y el motor nuevos y el
	# editor.js viejo: los botones nuevos no hacían nada. Para trabajar sin
	# conexión ya está el service worker, que guarda cada versión entera; con
	# «no-cache» el navegador solo pregunta si cambió (ETag), que es barato.
	header Cache-Control "no-cache"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	file_server
}

# Copiar a .env en el servidor (nunca al repositorio: .gitignore ya excluye .env).
#
# Generar la clave con:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# y guardarla ADEMÁS en el gestor de contraseñas de la empresa: sin ella, el
# fichero de credenciales de una copia de seguridad es irrecuperable.
CASAMBI_SECRET_KEY=

# Panel de Cloudflare Zero Trust → Access → la aplicación
CASAMBI_ACCESS_TEAM_DOMAIN=impelsa.cloudflareaccess.com
CASAMBI_ACCESS_AUD=

# Opcional: lista blanca de correos separados por comas. Vacío = cualquiera que
# supere las reglas de Access.
CASAMBI_ACCESS_EMAILS=

# Zero Trust → Networks → Tunnels → el token del túnel
TUNNEL_TOKEN=

# Copiar a copia.env junto a este fichero, con permisos 0600.
#
# Backblaze B2: el tramo gratuito de 10 GB cubre de sobra este proyecto.
RESTIC_REPOSITORY=b2:NOMBRE-DEL-CUBO:casambi
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# La contraseña de restic NO es la CASAMBI_SECRET_KEY. Hacen falta las dos para
# recuperar: la primera abre la copia, la segunda descifra las credenciales que
# hay dentro. Guarda ambas en el gestor de contraseñas de la empresa.

# Alternativa o complemento: repositorio en un disco del propio host. Al fijarlo,
# se ignora RESTIC_REPOSITORY y se usa este directorio.
#RESTIC_REPO_DIR=/srv/copias/casambi
